+203.0.113.88 - - [21/Oct/2026:11:02:07 +0000] \"GET /uploads/shell.php?cmd=id HTTP/1.1\" 200 61 \"-\" \"curl/8.5.0\"
+203.0.113.88 - - [21/Oct/2026:11:02:12 +0000] \"GET /admin/ HTTP/1.1\" 403 381 \"-\" \"curl/8.5.0\"
+""",
