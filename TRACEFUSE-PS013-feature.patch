+      const line=document.createElement('span');line.append(document.createTextNode(`Evidence: ${e.source_id}:${e.line_no} `));const btn=text('button','View original line','evidence-btn');btn.type='button';btn.addEventListener('click',async()=>{let pre=article.querySelector('.raw-line');if(pre&&pre.classList.contains('show')){pre.classList.remove('show');btn.textContent='View original line';return;}if(!pre){pre=document.createElement('pre');pre.className='raw-line';article.append(pre);}pre.textContent='Checking hash and loading original evidence…';pre.classList.add('show');btn.textContent='Hide original line';try{const u=new URL('/api/evidence',location.origin);u.searchParams.set('source_id',e.source_id);u.searchParams.set('line_no',e.line_no);const r=await fetch(u);const data=await r.json();if(!r.ok)throw new Error(data.error||'Evidence could not be verified');pre.textContent=`File: ${data.source_file}\nLine: ${data.line_no}\nFile SHA-256: ${data.file_sha256}\n\n${data.raw_line}`;}catch(err){pre.textContent=`Evidence unavailable: ${err.message}`;}});line.append(btn);meta.append(line);article.append(meta);box.append(article);
+    }
+  }
+  async function loadSummary(){const r=await fetch('/api/summary');const d=await r.json();if(!r.ok)throw new Error(d.error||'Could not load case summary');state.summary=d;$('caseTitle').textContent=`Case ${d.case_id}`;$('statEvents').textContent=d.events;$('statSources').textContent=d.source_count;$('statGaps').textContent=d.gaps;$('statWindow').textContent=d.first_ts_utc&&d.last_ts_utc?`${new Date(d.first_ts_utc).toLocaleDateString(undefined,{timeZone:'UTC'})} – ${new Date(d.last_ts_utc).toLocaleDateString(undefined,{timeZone:'UTC'})}`:'No events';$('integrityText').textContent=d.integrity_ok?'Evidence integrity verified':'Integrity warning';$('integrityDot').className='dot '+(d.integrity_ok?'ok':'bad');$('integritySub').textContent=d.integrity_ok?'Source hashes and custody chain passed':(d.integrity_issues||[]).slice(0,2).join('; ')||'One or more checks failed';renderSourceList(d.sources||[]);addOptions('source',(d.sources||[]).map(s=>s.source_id),'All sources');addOptions('action',d.actions||[],'All actions');}
+  async function loadEvents(){const p=apiFilters();p.set('limit',state.limit);p.set('offset',state.offset);const r=await fetch('/api/events?'+p.toString());const d=await r.json();if(!r.ok)throw new Error(d.error||'Could not load events');state.total=d.total;renderEvents(d.events);$('resultCount').textContent=`${d.total.toLocaleString()} event${d.total===1?'':'s'} match the current filters`;const from=d.total?state.offset+1:0,to=Math.min(state.offset+state.limit,d.total);$('pageInfo').textContent=`Showing ${from}–${to} of ${d.total}`;$('prevPage').disabled=state.offset===0;$('nextPage').disabled=state.offset+state.limit>=d.total;setExportLinks();}
+  async function reload(){try{await Promise.all([loadSummary(),loadEvents()]);}catch(err){$('timeline').replaceChildren(text('div',err.message,'empty'));$('resultCount').textContent='Could not load timeline';}}
+  $('applyFilters').addEventListener('click',()=>{state.offset=0;reload()});$('refresh').addEventListener('click',reload);$('resetFilters').addEventListener('click',()=>{for(const id of filters)$(id).value='';state.offset=0;reload()});$('prevPage').addEventListener('click',()=>{state.offset=Math.max(0,state.offset-state.limit);loadEvents()});$('nextPage').addEventListener('click',()=>{if(state.offset+state.limit<state.total){state.offset+=state.limit;loadEvents()}});
+  $('q').addEventListener('keydown',e=>{if(e.key==='Enter'){state.offset=0;reload()}});for(const id of ['source','action','outcome','start','end'])$(id).addEventListener('change',()=>{state.offset=0;reload()});$('q').addEventListener('input',()=>{clearTimeout(state.debounce);state.debounce=setTimeout(()=>{state.offset=0;reload()},350)});
